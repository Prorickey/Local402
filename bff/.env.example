# ---------------------------------------------------------------------------
# Local402 BFF environment.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# Coinbase Developer Platform (CDP) Server Wallet v2 API credentials.
# Create at https://portal.cdp.coinbase.com/ -> API Keys (Secret API Key).
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

# Wallet Secret used by the v2 Server Wallet SDK to authorize signing.
# Generated in the CDP portal under Server Wallets. Distinct from the API key.
CDP_WALLET_SECRET=your-cdp-wallet-secret

# Name of the treasury CDP server account that holds real USDC on Base mainnet.
# The BFF calls getOrCreateAccount({ name: TREASURY_ACCOUNT }) at startup, so
# this is a stable account NAME (not an address). Pre-fund its address with USDC.
TREASURY_ACCOUNT=local402-treasury

# Name of the user's agent wallet. The BFF calls
# getOrCreateAccount({ name: USER_ACCOUNT }) so the wallet is created
# automatically on first /wallet/create and reused on every later call
# (idempotent — no duplicate wallets, no login).
USER_ACCOUNT=local402-user

# Network. Must be "base" (Base mainnet) for this build.
NETWORK=base

# USDC contract address on Base mainnet (used for the viem balanceOf fallback).
USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# HTTP port for the BFF.
PORT=8787

# Optional: public Base RPC endpoint for the viem fallback balance read.
# Defaults to https://mainnet.base.org if unset.
BASE_RPC_URL=https://mainnet.base.org

# Optional: x402 receiver address the demo settles micro-payments TO.
# Defaults to the treasury account's own address (settle-to-self) if unset.
X402_RECEIVER_ADDRESS=

# Maximum a single /fund call may credit, in USD. Server-side hard cap.
MAX_FUND_USD=200
