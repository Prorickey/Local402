{
  "name": "local402-bff",
  "version": "0.1.0",
  "private": true,
  "description": "Backend-for-frontend that brokers all Coinbase CDP calls for the Local402 macOS app. Holds the CDP secret + treasury server wallet so no secrets ship in the native app.",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "1.51.0",
    "@coinbase/x402": "2.1.0",
    "@x402/evm": "^2.14.0",
    "@x402/fetch": "^2.14.0",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "4.22.2",
    "viem": "2.52.0",
    "x402": "1.2.0"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "20.19.41",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
